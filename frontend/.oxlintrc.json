{
  "plugins": ["react", "jsx-a11y", "import", "unicorn"],
  "env": {
    "browser": true,
    "node": true
  },
  "rules": {
    "no-unused-vars": "error",
    "no-empty": "error",
    "import/no-cycle": "error",
    "complexity": ["error", 8],
    "max-lines-per-function": [
      "error",
      {
        "max": 100
      }
    ],
    "max-params": ["error", 5]
  },
  "ignorePatterns": ["node_modules", ".next"]
}
